{
  "name": "ROS 2 Development Container",
  "privileged": true,
  "remoteUser": "${localEnv:USER}",
  "build": {
      "dockerfile": "Dockerfile",
      "args": {
          "USERNAME": "${localEnv:USER}"
      }
  },
  "workspaceFolder": "/workspaces/ros2",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ros2,type=bind",
  "customizations": {
      "vscode": {
          "extensions":[
              "ms-vscode.cpptools",
              "ms-vscode.cpptools-themes",
              "twxs.cmake",
              "donjayamanne.python-extension-pack",
              "eamodio.gitlens",
              "ms-iot.vscode-ros"
          ]
      }
  },
  "containerEnv": {
      "DISPLAY": "unix:0",
      "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
      "ROS_DOMAIN_ID": "42"
  },
  "runArgs": [
      "--net=host",
      "--pid=host",
      "--ipc=host",
      "--privileged",
      "--cap-add=SYS_PTRACE",
      "--cap-add=SYS_NICE",
      "--ulimit", "rtprio=99",
      "-e", "DISPLAY=${env:DISPLAY}"
  ],
  "mounts": [
     "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
     "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
     "source=/workspaces/isaac,target=/workspaces/isaac,type=bind"
  ],
  "postCreateCommand": "sudo rosdep update && sudo rosdep install --from-paths /workspaces/ros2/src --ignore-src -y --skip-keys 'fastcdr rti-connext-dds-7.3.0 urdfdom_headers'"
}